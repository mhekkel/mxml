EXCLUDE_SYMBOLS        = std* zeem::doctype::*
FILE_PATTERNS          = *.hpp
PREDEFINED             += and=&& or=|| not=! ZEEM_EXPORT=export ZEEM_INLINE=inline
GENERATE_XML           = YES
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_TODOLIST      = NO
INPUT                  = @DOXYGEN_INPUT_DIR@
